{
  "schemaVersion": 1,
  "id": "io.github.grichard99.protonvpn",
  "name": "OmaProton VPN",
  "version": "1.1.0",
  "author": "grichard99",
  "license": "MIT",
  "description": "Proton VPN, built for Omarchy. No terminal: one click to connect, a city picker, Kill Switch \u2014 in a widget that wears every Omarchy theme.",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "Panel.qml"
  },
  "barWidget": {
    "displayName": "OmaProton VPN",
    "description": "Toggle Proton VPN, quick-connect by feature, pick a country or city, and manage Kill Switch and NetShield.",
    "category": "Network",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "refreshIntervalSec": 30,
      "watchIntervalSec": 4,
      "notifications": "on"
    },
    "schema": [
      {
        "key": "refreshIntervalSec",
        "type": "integer",
        "label": "Status refresh interval (seconds)",
        "min": 5,
        "max": 3600,
        "step": 5,
        "defaultValue": 30
      },
      {
        "key": "watchIntervalSec",
        "type": "integer",
        "label": "Link watch interval (seconds)",
        "min": 2,
        "max": 60,
        "step": 1,
        "defaultValue": 4
      },
      {
        "key": "notifications",
        "type": "enum",
        "label": "Desktop notifications",
        "options": [
          {
            "value": "on",
            "label": "On"
          },
          {
            "value": "off",
            "label": "Off"
          }
        ],
        "defaultValue": "on"
      }
    ]
  }
}
